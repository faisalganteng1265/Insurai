# 0G Chain
# Mainnet: 16661 / https://evmrpc.0g.ai
# Galileo testnet: 16602 / https://evmrpc-testnet.0g.ai
ZG_CHAIN_ID=16661
ZG_CHAIN_NAME=0G Mainnet
ZG_RPC_URL=https://evmrpc.0g.ai
PROVIDER_PRIVATE_KEY=your_private_key_here

# Contract addresses (fill after deploy)
STRATEGY_REGISTRY_ADDRESS=0x
POLICY_MANAGER_ADDRESS=0x
INSURANCE_POOL_ADDRESS=0x
USDC_ADDRESS=0x
MAX_CLAIMS_PER_ATTESTATION=25
DEMO_PULSE_MOMENTUM_STRATEGY_ID=2

# 0G Compute (get provider address from 0G network explorer)
ZG_COMPUTE_PROVIDER_ADDRESS=0x_provider_node_address
ZG_COMPUTE_MODEL=Qwen/Qwen2.5-7B-Instruct
ZG_COMPUTE_REQUIRE_TEE_ACK=true
ZG_COMPUTE_REQUIRE_TEE_RESPONSE=true

# 0G Storage
ZG_STORAGE_RPC=https://rpc-storage.0g.ai
ZG_STORAGE_INDEXER_RPC=https://indexer-storage-turbo.0g.ai

PORT=3001
